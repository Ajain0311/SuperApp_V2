# ==============================================================================
# SuperApp Unified Environment Configuration Template (.env.example)
# Copy this file to .env for local development
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SMS & OTP Service Configuration (BIGB Gateway)
# ------------------------------------------------------------------------------
# Base URL for the BIGB SMS API
SMS_API_URL=https://eapi.punjab.gov.in/smapi/sms

# DLT Server Key authentication header
SMS_SERVER_KEY=YOUR_SMS_SERVER_KEY_HERE

# Approved DLT Template ID for Sanwaliya Ji OTP
SMS_TEMPLATE_ID=1407177633307627182

# OTP Provider: BIGB | Mock
OTP_PROVIDER=BIGB

# Temporary Test OTP Mode for automated/local/UAT testing (true | false)
# CRITICAL PRODUCTION SAFETY: Must always be false in production environments.
# When true, real SMS dispatch is inhibited and deterministic TEST_OTP is accepted.
OTP_TEST_MODE=false

# Default Test OTP for local development and automated testing
TEST_OTP=123456

# ------------------------------------------------------------------------------
# 2. Database Provider & Connection Strings (ASP.NET Core EF Core)
# ------------------------------------------------------------------------------
# Supported Providers: Postgres | SqlServer | InMemory
DATABASE_PROVIDER=Postgres

# PostgreSQL Database Connection String
ConnectionStrings__SupabaseConnection=Host=127.0.0.1;Port=5432;Database=azuredb;Username=azuredbuser;Password=YOUR_DATABASE_PASSWORD_HERE;
ConnectionStrings__DefaultConnection=Host=127.0.0.1;Port=5432;Database=azuredb;Username=azuredbuser;Password=YOUR_DATABASE_PASSWORD_HERE;

# ------------------------------------------------------------------------------
# 3. Security & JWT Token Authority
# ------------------------------------------------------------------------------
JWT_SECRET=SuperApp_Development_Secret_Key_2026_Must_Be_At_Least_32_Characters
JWT_ISSUER=SuperApp
JWT_AUDIENCE=SuperApp

# ------------------------------------------------------------------------------
# 4. Service Providers & Feature Toggles
# ------------------------------------------------------------------------------
PAYMENT_PROVIDER=Mock
# Mock | Mapbox — Mapbox requires MAPBOX_ACCESS_TOKEN (server) + EXPO_PUBLIC_MAPBOX_ACCESS_TOKEN (client)
MAP_PROVIDER=Mock
MAPBOX_ACCESS_TOKEN=
# Supported Providers: Expo | Firebase | None
NOTIFICATION_PROVIDER=Expo
# Expo Push Access Token (optional for standard rate limits, recommended for production)
EXPO_ACCESS_TOKEN=
# Firebase Cloud Messaging credentials (if using Firebase provider)
FCM_SERVER_KEY=
FIREBASE_SERVICE_ACCOUNT_JSON=

# ------------------------------------------------------------------------------
# 5. React Native + Expo Mobile Client Configuration
# ------------------------------------------------------------------------------
# Environment: dev | staging | prod
EXPO_PUBLIC_ENV=dev

# API Gateway Base URL (Defaults to http://localhost:80/api on Web/iOS, http://10.0.2.2:80/api on Android Emulator)
EXPO_PUBLIC_API_BASE_URL=http://localhost:80/api

# Real-Time SignalR WebSocket Base URL
EXPO_PUBLIC_SIGNALR_HUB_URL=http://localhost:80

# Prominently show Test OTP hint/auto-fill button on OTP screen (true | false)
EXPO_PUBLIC_SHOW_TEST_OTP=false

# Test OTP code to suggest and auto-fill in mobile UI
EXPO_PUBLIC_TEST_OTP=123456

# Enable debug console logs in Expo
EXPO_PUBLIC_ENABLE_LOGS=true

# Mapbox public access token (pk.*) — required for map + place search on Dev Client builds
# Expo Go does not support @rnmapbox/maps; use: npx expo prebuild && npx expo run:android
EXPO_PUBLIC_MAPBOX_ACCESS_TOKEN=

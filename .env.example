# SuperApp React Native + Expo Environment Configuration
# Copy this file to .env or .env.local for local development

# Target Environment: dev | staging | prod
EXPO_PUBLIC_ENV=dev

# API Base URL (Defaults to http://localhost:5000/api on Web/iOS, http://10.0.2.2:5000/api on Android Emulator)
EXPO_PUBLIC_API_BASE_URL=http://localhost:5000/api

# Optional SignalR Root URL override (defaults to root of EXPO_PUBLIC_API_BASE_URL without /api)
EXPO_PUBLIC_SIGNALR_HUB_URL=http://localhost:5000

# Enable verbose logging (true in dev by default)
EXPO_PUBLIC_ENABLE_LOGS=true

# ==============================================================================
# ASP.NET Core Backend Database Provider Configuration (SuperApp.API)
# ==============================================================================
# Supported Providers: InMemory | SqlServer | Postgres
DATABASE_PROVIDER=InMemory

# Supabase PostgreSQL Configuration (Use dotnet user-secrets or local environment variables)
# Preferred Pattern: ConnectionStrings__SupabaseConnection
ConnectionStrings__SupabaseConnection=Host=db.drhjfkqeiijdmyettumz.supabase.co;Port=5432;Database=postgres;Username=postgres;Password=<LOCAL_SECRET>;SSL Mode=Require;Trust Server Certificate=true;

# Alternative generic connection string override:
# DATABASE_CONNECTION_STRING=Host=db.drhjfkqeiijdmyettumz.supabase.co;Port=5432;Database=postgres;Username=postgres;Password=<LOCAL_SECRET>;SSL Mode=Require;Trust Server Certificate=true;

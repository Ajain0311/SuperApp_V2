# SuperApp React Native + Expo Environment Configuration
# Copy this file to .env or .env.local for local development

# Target Environment: dev | staging | prod
EXPO_PUBLIC_ENV=dev

# API Base URL (Defaults to http://localhost:5000/api on Web/iOS, http://10.0.2.2:5000/api on Android Emulator)
EXPO_PUBLIC_API_BASE_URL=http://localhost:5000/api

# Optional SignalR Root URL override (defaults to root of EXPO_PUBLIC_API_BASE_URL without /api)
EXPO_PUBLIC_SIGNALR_HUB_URL=http://localhost:5000

# Enable verbose logging (true in dev by default)
EXPO_PUBLIC_ENABLE_LOGS=true

# ==============================================================================
# ASP.NET Core Backend Database Provider Configuration (SuperApp.API)
# ==============================================================================
# Supported Providers: InMemory | SqlServer | Postgres (Supabase)
# DATABASE_PROVIDER=InMemory
# DATABASE_PROVIDER=SqlServer
# DATABASE_PROVIDER=Postgres

# Database Connection String Overrides:
# SqlServer:
# DATABASE_CONNECTION_STRING=Server=localhost;Database=SuperAppDB;Trusted_Connection=true;TrustServerCertificate=true;MultipleActiveResultSets=true;
#
# Supabase / PostgreSQL (Pooler Mode - Transaction / Session):
# DATABASE_CONNECTION_STRING=Host=aws-0-ap-south-1.pooler.supabase.com;Port=5432;Database=postgres;Username=postgres.[YOUR-PROJECT-REF];Password=[YOUR-PASSWORD];SSL Mode=Require;Trust Server Certificate=true;

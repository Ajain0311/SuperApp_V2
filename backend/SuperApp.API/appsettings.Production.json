{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Error"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=superapp-db,1433;Database=SuperAppDb;User Id=sa;Password=<SET_VIA_ENV>;TrustServerCertificate=true;MultipleActiveResultSets=true;Encrypt=True"
  },
  "Jwt": {
    "Secret": "<SET_JWT_SECRET_64_CHARS>",
    "Issuer": "SuperAppProduction",
    "Audience": "SuperAppAudience",
    "ExpiryDays": 30
  },
  "AppSettings": {
    "Environment": "Production",
    "EnableSwagger": false,
    "StorageBaseUrl": "/uploads/",
    "CorsAllowedOrigins": [
      "https://admin.superapp.internal",
      "https://vendor.superapp.internal",
      "http://localhost:80",
      "http://localhost:8080"
    ]
  }
}
